# =====================================================================
# KaushalDrishti Platform Configuration
# =====================================================================

# Server Port (Default: 8000)
PORT=8000

# ---------------------------------------------------------------------
# Database Configuration (PostgreSQL / SQLite Hybrid Fallback)
# ---------------------------------------------------------------------
# If DATABASE_URL is set, KaushalDrishti connects to PostgreSQL (e.g., Supabase, Neon, Render, RDS).
# All uploaded telemetry batches, audit receipts, and microdata records will be persisted
# in PostgreSQL and synced live across all users, browsers, and devices globally.
#
# If DATABASE_URL is left blank, KaushalDrishti automatically falls back to local SQLite
# (data/kaushaldrishti.db) with zero network dependency.

# --- Example 1: Supabase PostgreSQL (Recommended) ---
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Example 2: Neon Serverless PostgreSQL ---
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[EP-NAME].us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Example 3: Render PostgreSQL ---
# DATABASE_URL=postgresql://[USER]:[PASSWORD]@[HOST].render.com/[DATABASE]?sslmode=require

# --- Example 4: Local PostgreSQL ---
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kaushaldrishti
